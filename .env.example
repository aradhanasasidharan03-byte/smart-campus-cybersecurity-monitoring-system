APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-before-use

# SQLite is used by default for a zero-setup local demo.
DATABASE_URL=sqlite:///campus_security.db
# PostgreSQL: postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# MySQL: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/smart_campus_security?charset=utf8mb4
PORT=5000

# Optional local demo account passwords. replace-with-* values trigger random
# passwords printed once to the local server console during first-time seeding.
DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password
DEMO_ANALYST_PASSWORD=replace-with-demo-analyst-password
DEMO_VIEWER_PASSWORD=replace-with-demo-viewer-password

SEED_DEMO=true
COOKIE_SECURE=false
